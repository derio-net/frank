{{- $pages := slice -}}
{{- range site.RegularPages -}}
{{- $source := "" -}}{{- with .File }}{{ $source = .Path }}{{ end -}}
{{- $state := "unknown" -}}{{- if isset .Params "commands_change_state" }}{{ $state = .Params.commands_change_state }}{{ end -}}
{{- $pages = $pages | append (dict "id" .RelPermalink "title" .Title "url" .Permalink "markdown_url" (printf "%sindex.md" .Permalink) "summary" (or .Description .Params.summary .Params.tldr .Summary | plainify | htmlUnescape) "series" (.Params.series | default slice) "layer" (.Params.layer | default "") "tags" (.Params.tags | default slice) "published" (.Date.Format "2006-01-02") "updated" (.Lastmod.Format "2006-01-02") "last_verified" (.Params.last_verified | default false) "tested_versions" (.Params.tested_versions | default slice) "prerequisites" (.Params.prerequisites | default slice) "commands_change_state" $state "reader_goal" (.Params.reader_goal | default "") "source_path" $source "related_building" (.Params.related_building | default "") "related_operating" (.Params.related_operating | default "")) -}}
{{- end -}}
{{- dict "schema_version" 1 "site" site.BaseURL "articles" $pages | jsonify -}}
