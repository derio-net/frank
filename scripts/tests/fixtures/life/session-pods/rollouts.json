{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "cluster-update-fr",
      "cluster-update.fr/type": "rollouts",
      "fr.run/id": "upg-rollouts"
    },
    "name": "us-upg-rollouts-46c97ce8",
    "namespace": "upgrade-sessions"
  },
  "spec": {
    "automountServiceAccountToken": true,
    "containers": [
      {
        "env": [
          {
            "name": "HOME",
            "value": "/home/claude"
          },
          {
            "name": "UPGRADE_TALOS_MINOR",
            "value": "1.12"
          },
          {
            "name": "UPGRADE_K8S_MINOR",
            "value": "1.35"
          },
          {
            "name": "UPGRADE_ID",
            "value": "upg-rollouts"
          },
          {
            "name": "UPGRADE_TYPE",
            "value": "rollouts"
          },
          {
            "name": "UPGRADE_CLUSTER",
            "value": "frank"
          },
          {
            "name": "UPGRADE_APP",
            "value": "app"
          },
          {
            "name": "TALOSCTL_VERSION",
            "value": "v1.12.6"
          },
          {
            "name": "KUBECTL_VERSION",
            "value": "v1.35.3"
          },
          {
            "name": "CONSOLE_URL",
            "value": "http://cluster-update-fr.cluster-update-fr.svc:8081"
          },
          {
            "name": "DISABLE_AUTOUPDATER",
            "value": "1"
          },
          {
            "name": "CREDENTIALS_DIR",
            "value": "/run/credentials"
          }
        ],
        "image": "ghcr.io/derio-net/upgrade-session@sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "imagePullPolicy": "IfNotPresent",
        "name": "session",
        "resources": {
          "limits": {
            "cpu": "2",
            "memory": "4Gi"
          },
          "requests": {
            "cpu": "100m",
            "memory": "512Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "stdin": true,
        "tty": true,
        "volumeMounts": [
          {
            "mountPath": "/home/claude",
            "name": "home"
          },
          {
            "mountPath": "/tmp",
            "name": "tmp"
          },
          {
            "mountPath": "/run/credentials",
            "name": "credentials",
            "readOnly": true
          },
          {
            "mountPath": "/home/claude/brief",
            "name": "brief",
            "readOnly": true
          },
          {
            "mountPath": "/home/claude/AGENTS.md",
            "name": "brief",
            "readOnly": true,
            "subPath": "AGENTS.md"
          },
          {
            "mountPath": "/home/claude/CLAUDE.md",
            "name": "brief",
            "readOnly": true,
            "subPath": "CLAUDE.md"
          }
        ]
      }
    ],
    "enableServiceLinks": false,
    "restartPolicy": "Never",
    "securityContext": {
      "fsGroup": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "serviceAccountName": "upgrade-session-rollouts",
    "volumes": [
      {
        "emptyDir": {
          "sizeLimit": "4Gi"
        },
        "name": "home"
      },
      {
        "emptyDir": {
          "sizeLimit": "1Gi"
        },
        "name": "tmp"
      },
      {
        "name": "credentials",
        "secret": {
          "defaultMode": 256,
          "items": [
            {
              "key": "github-token",
              "path": "github-token"
            },
            {
              "key": "session-step-token",
              "path": "session-step-token"
            }
          ],
          "secretName": "us-upg-rollouts-46c97ce8-creds"
        }
      },
      {
        "name": "brief",
        "secret": {
          "defaultMode": 292,
          "secretName": "us-upg-rollouts-46c97ce8-brief"
        }
      }
    ]
  }
}
