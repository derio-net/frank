{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "cluster-update-fr",
      "cluster-update.fr/type": "hop-os",
      "fr.run/id": "upg-hop-os"
    },
    "name": "us-upg-hop-os-e006b824",
    "namespace": "upgrade-sessions"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "env": [
          {
            "name": "HOME",
            "value": "/home/claude"
          },
          {
            "name": "UPGRADE_TALOS_MINOR",
            "value": "1.12"
          },
          {
            "name": "UPGRADE_K8S_MINOR",
            "value": "1.35"
          },
          {
            "name": "UPGRADE_ID",
            "value": "upg-hop-os"
          },
          {
            "name": "UPGRADE_TYPE",
            "value": "hop-os"
          },
          {
            "name": "UPGRADE_CLUSTER",
            "value": "frank"
          },
          {
            "name": "UPGRADE_APP",
            "value": "app"
          },
          {
            "name": "TALOSCTL_VERSION",
            "value": "v1.12.6"
          },
          {
            "name": "KUBECTL_VERSION",
            "value": "v1.35.3"
          },
          {
            "name": "CONSOLE_URL",
            "value": "http://cluster-update-fr.cluster-update-fr.svc:8081"
          },
          {
            "name": "DISABLE_AUTOUPDATER",
            "value": "1"
          },
          {
            "name": "CREDENTIALS_DIR",
            "value": "/run/credentials"
          },
          {
            "name": "ALL_PROXY",
            "value": "socks5://localhost:1055"
          },
          {
            "name": "HTTPS_PROXY",
            "value": "socks5://localhost:1055"
          },
          {
            "name": "NO_PROXY",
            "value": "localhost,127.0.0.1,.svc,.cluster.local,cluster-update-fr.cluster-update-fr.svc"
          }
        ],
        "image": "ghcr.io/derio-net/upgrade-session@sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "imagePullPolicy": "IfNotPresent",
        "name": "session",
        "resources": {
          "limits": {
            "cpu": "2",
            "memory": "4Gi"
          },
          "requests": {
            "cpu": "100m",
            "memory": "512Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "stdin": true,
        "tty": true,
        "volumeMounts": [
          {
            "mountPath": "/home/claude",
            "name": "home"
          },
          {
            "mountPath": "/tmp",
            "name": "tmp"
          },
          {
            "mountPath": "/run/credentials",
            "name": "credentials",
            "readOnly": true
          },
          {
            "mountPath": "/home/claude/brief",
            "name": "brief",
            "readOnly": true
          },
          {
            "mountPath": "/home/claude/AGENTS.md",
            "name": "brief",
            "readOnly": true,
            "subPath": "AGENTS.md"
          },
          {
            "mountPath": "/home/claude/CLAUDE.md",
            "name": "brief",
            "readOnly": true,
            "subPath": "CLAUDE.md"
          }
        ]
      }
    ],
    "enableServiceLinks": false,
    "initContainers": [
      {
        "env": [
          {
            "name": "TS_USERSPACE",
            "value": "true"
          },
          {
            "name": "TS_STATE_DIR",
            "value": "/ts-state"
          },
          {
            "name": "TS_SOCKET",
            "value": "/ts-state/tailscaled.sock"
          },
          {
            "name": "TS_KUBE_SECRET",
            "value": ""
          },
          {
            "name": "TS_SOCKS5_SERVER",
            "value": "localhost:1055"
          },
          {
            "name": "TS_AUTHKEY",
            "valueFrom": {
              "secretKeyRef": {
                "key": "tailscale-authkey",
                "name": "us-upg-hop-os-e006b824-creds"
              }
            }
          },
          {
            "name": "TS_EXTRA_ARGS",
            "value": "--login-server=https://headscale.hop.derio.net --hostname=frank-upgrade-upg-hop-os --advertise-tags=tag:frank-updater"
          }
        ],
        "image": "ghcr.io/tailscale/tailscale@sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "imagePullPolicy": "IfNotPresent",
        "name": "tailscale",
        "resources": {
          "limits": {
            "cpu": "200m",
            "memory": "256Mi"
          },
          "requests": {
            "cpu": "20m",
            "memory": "64Mi"
          }
        },
        "restartPolicy": "Always",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 65531,
          "runAsUser": 65531
        },
        "volumeMounts": [
          {
            "mountPath": "/ts-state",
            "name": "ts-state"
          },
          {
            "mountPath": "/tmp",
            "name": "ts-tmp"
          }
        ]
      }
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "fsGroup": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "volumes": [
      {
        "emptyDir": {
          "sizeLimit": "4Gi"
        },
        "name": "home"
      },
      {
        "emptyDir": {
          "sizeLimit": "1Gi"
        },
        "name": "tmp"
      },
      {
        "name": "credentials",
        "secret": {
          "defaultMode": 256,
          "items": [
            {
              "key": "github-token",
              "path": "github-token"
            },
            {
              "key": "hop-kubeconfig",
              "path": "hop-kubeconfig"
            },
            {
              "key": "hop-talosconfig",
              "path": "hop-talosconfig"
            },
            {
              "key": "session-step-token",
              "path": "session-step-token"
            }
          ],
          "secretName": "us-upg-hop-os-e006b824-creds"
        }
      },
      {
        "name": "brief",
        "secret": {
          "defaultMode": 292,
          "secretName": "us-upg-hop-os-e006b824-brief"
        }
      },
      {
        "emptyDir": {
          "sizeLimit": "64Mi"
        },
        "name": "ts-state"
      },
      {
        "emptyDir": {
          "sizeLimit": "64Mi"
        },
        "name": "ts-tmp"
      }
    ]
  }
}
