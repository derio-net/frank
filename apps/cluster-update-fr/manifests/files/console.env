# Console configuration (read once at boot; the Kustomize configMapGenerator hash-suffixes
# this ConfigMap so any edit rolls the pod). Plain KEY=VALUE, no quoting.
# Contract: derio-net/cluster-update-fr README, "Configuration".

# --- PR trust ----------------------------------------------------------------------------
# The frank repo is public: the console acts only on PRs authored by these logins. EMPTY
# means "trust nothing" -- never put a placeholder here, a placeholder is a login someone
# could register. Phase 7 fills them from the Apps it creates (renovate / console / session).
# Branch prefixes are built into the console (renovate/, cluster-update/batch-, ...revert-,
# ...session-<id>/); the CI contexts that must be green are `required_ci_contexts` in
# update-policy.yaml.
RENOVATE_BOT_LOGIN=
CONSOLE_BOT_LOGIN=
SESSION_BOT_LOGIN=
# GitHub login(s) of the Gitea->GitHub status bridge (the identity that posts gitea-actions/*).
# Empty: nothing passes CI.
STATUS_CREATOR_LOGINS=
TRUSTED_COMMITTERS=web-flow
FRANK_REPO=derio-net/frank
FRANK_REF=main

# --- Identity: Authentik signed JWT (X-authentik-jwt), operator group only -----------------
AUTHENTIK_ISSUER=https://auth.cluster.derio.net/application/o/updates-cluster/
AUTHENTIK_JWKS_URL=https://auth.cluster.derio.net/application/o/updates-cluster/jwks/
AUTHENTIK_AUDIENCE=cluster-update-console
OPERATOR_GROUP=root-admins

# --- Listeners (ports are part of the network policy) ---------------------------------------
LISTEN=:8080
OPS_LISTEN=:9090
SESSION_API_LISTEN=:8081
CONSOLE_URL=https://updates.cluster.derio.net
RUNS_FR_URL=https://sessions.cluster.derio.net

# --- Sources ---------------------------------------------------------------------------------
GITEA_URL=http://gitea-http.gitea.svc.cluster.local:3000
VICTORIALOGS_URL=http://victoria-logs-victoria-logs-single-server.monitoring.svc.cluster.local:9428
HOP_KUBECONFIG=/var/run/credentials/hop/config
OMNI_STATUS_FILE=/var/run/omni-status/status.json

# --- Credentials (files, re-read on use; every Secret is optional) -----------------------------
GITHUB_TOKEN_FILE=/var/run/credentials/github/token
GITEA_TOKEN_FILE=/var/run/credentials/gitea/token
FRANK_UPDATER_TELEGRAM_BOT_TOKEN_FILE=/var/run/credentials/telegram/bot-token

# --- Sessions --------------------------------------------------------------------------------
SESSION_NAMESPACE=upgrade-sessions
SESSION_SECRET_DIR=/var/run/session-credentials
SESSION_API_URL=http://cluster-update-fr-session.cluster-update-fr.svc.cluster.local:8081
# The upgrade-session image (agent-images@1f893195). Same pin as the omni-status sidecar in
# deployment.yaml; empty would disable launching a session.
SESSION_IMAGE=ghcr.io/derio-net/upgrade-session:1f89319519ae19e930ec5ba2a33dda0b6c2c0140@sha256:8dcb0ece8b00c3aa2232e8f1b26dd4ba6afdcd5e04ec42865e7efd63fcde79da
# hop-os only: the userspace tailscale sidecar. Must be EXACTLY the tailscaleImage digest
# pinned in admission-policy.yaml; any other value is denied at admission, and an empty value
# makes the console refuse hop-os sessions.
SESSION_TAILSCALE_IMAGE=tailscale/tailscale:v1.82.5@sha256:9a1f2640beecac3ad42ed8ef03d75adcb7165600f5131b17f9a2a3da68505928
# Sessions join Hop's tailnet as their own tag, granted only hop-1's Kubernetes and Talos APIs
# (p5-r3); never hop-scan's tag:frank-updater.
SESSION_TAILSCALE_TAG=tag:frank-session

# --- State -------------------------------------------------------------------------------------
STATE_DIR=/var/lib/cluster-update-fr
